{
  "__inputs": [
    {
      "name": "DS_ELASTICSEARCH",
      "label": "QaaS execution logs",
      "description": "Elasticsearch data source for qaas-* using @timestamp.",
      "type": "datasource",
      "pluginId": "elasticsearch",
      "pluginName": "Elasticsearch"
    }
  ],
  "title": "QaaS Mocker usage",
  "uid": "qaas-mocker-usage",
  "description": "Observed usage and outcomes from QaaS structured logs in Elasticsearch.",
  "schemaVersion": 40,
  "version": 1,
  "tags": [
    "qaas",
    "mocker"
  ],
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "exact",
        "type": "query",
        "datasource": {
          "type": "elasticsearch",
          "uid": "${DS_ELASTICSEARCH}"
        },
        "refresh": 1,
        "hide": 2,
        "skipUrlSync": true,
        "query": "{\"find\": \"fields\", \"type\": \"keyword\"}",
        "regex": "/^fields\\.QaasEvent\\.(keyword|raw)$/",
        "options": [],
        "current": {}
      },
      {
        "name": "Team",
        "type": "query",
        "datasource": {
          "type": "elasticsearch",
          "uid": "${DS_ELASTICSEARCH}"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "query": "{\"find\": \"terms\", \"field\": \"fields.Team.${exact:raw}\", \"query\": \"fields.QaasEvent.${exact:raw}:(MockerExecutionStarted OR MockerExecutionFinished OR MockerHttpRequests)\", \"size\": 1000}"
      },
      {
        "name": "System",
        "type": "query",
        "datasource": {
          "type": "elasticsearch",
          "uid": "${DS_ELASTICSEARCH}"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "query": "{\"find\": \"terms\", \"field\": \"fields.System.${exact:raw}\", \"query\": \"fields.QaasEvent.${exact:raw}:(MockerExecutionStarted OR MockerExecutionFinished OR MockerHttpRequests)\", \"size\": 1000}"
      },
      {
        "name": "Environment",
        "type": "query",
        "datasource": {
          "type": "elasticsearch",
          "uid": "${DS_ELASTICSEARCH}"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "query": "{\"find\": \"terms\", \"field\": \"fields.Environment.${exact:raw}\", \"query\": \"fields.QaasEvent.${exact:raw}:(MockerExecutionStarted OR MockerExecutionFinished OR MockerHttpRequests)\", \"size\": 1000}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Executions started",
      "description": "One start per observed execution in the selected time range.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "${DS_ELASTICSEARCH}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "${DS_ELASTICSEARCH}"
          },
          "query": "fields.QaasEvent.${exact:raw}:\"MockerExecutionStarted\" AND fields.Team.${exact:raw}:${Team:lucene} AND fields.System.${exact:raw}:${System:lucene} AND fields.Environment.${exact:raw}:${Environment:lucene}",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "field": "fields.QaasEvent.${exact:raw}",
              "id": "2",
              "settings": {
                "size": "1",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ],
          "alias": "",
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "none",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 2,
      "title": "Active teams",
      "description": "Estimated distinct teams with a recorded start in the selected time range.",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "${DS_ELASTICSEARCH}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "${DS_ELASTICSEARCH}"
          },
          "query": "fields.QaasEvent.${exact:raw}:\"MockerExecutionStarted\" AND fields.Team.${exact:raw}:${Team:lucene} AND fields.System.${exact:raw}:${System:lucene} AND fields.Environment.${exact:raw}:${Environment:lucene}",
          "metrics": [
            {
              "id": "1",
              "type": "cardinality",
              "field": "fields.Team.${exact:raw}"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "field": "fields.QaasEvent.${exact:raw}",
              "id": "2",
              "settings": {
                "size": "1",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ],
          "alias": "",
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "none",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 3,
      "title": "Active systems",
      "description": "Estimated distinct system names with a recorded start in the selected time range.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "${DS_ELASTICSEARCH}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "${DS_ELASTICSEARCH}"
          },
          "query": "fields.QaasEvent.${exact:raw}:\"MockerExecutionStarted\" AND fields.Team.${exact:raw}:${Team:lucene} AND fields.System.${exact:raw}:${System:lucene} AND fields.Environment.${exact:raw}:${Environment:lucene}",
          "metrics": [
            {
              "id": "1",
              "type": "cardinality",
              "field": "fields.System.${exact:raw}"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "field": "fields.QaasEvent.${exact:raw}",
              "id": "2",
              "settings": {
                "size": "1",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ],
          "alias": "",
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "none",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 4,
      "title": "Execution failure rate",
      "description": "Failed terminal records divided by all terminal records in the selected time range. Executions still running have no terminal record.",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "${DS_ELASTICSEARCH}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "${DS_ELASTICSEARCH}"
          },
          "query": "fields.QaasEvent.${exact:raw}:\"MockerExecutionFinished\" AND fields.Team.${exact:raw}:${Team:lucene} AND fields.System.${exact:raw}:${System:lucene} AND fields.Environment.${exact:raw}:${Environment:lucene}",
          "metrics": [
            {
              "id": "1",
              "type": "avg",
              "field": "fields.Failed"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "field": "fields.QaasEvent.${exact:raw}",
              "id": "2",
              "settings": {
                "size": "1",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ],
          "alias": "",
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "none",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 5,
      "title": "Starts by environment",
      "description": "Framework classifies a process as CI when KUBERNETES_SERVICE_HOST exists, otherwise Local.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "${DS_ELASTICSEARCH}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "${DS_ELASTICSEARCH}"
          },
          "query": "fields.QaasEvent.${exact:raw}:\"MockerExecutionStarted\" AND fields.Team.${exact:raw}:${Team:lucene} AND fields.System.${exact:raw}:${System:lucene} AND fields.Environment.${exact:raw}:${Environment:lucene}",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "field": "fields.Environment.${exact:raw}",
              "id": "2",
              "settings": {
                "size": "25",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            },
            {
              "id": "3",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ],
          "alias": "{{term fields.Environment.${exact:raw}}}",
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 65,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 6,
      "title": "Starts by team and system",
      "description": "Up to 25 most active teams and their top 25 systems in the selected time range.",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "${DS_ELASTICSEARCH}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "${DS_ELASTICSEARCH}"
          },
          "query": "fields.QaasEvent.${exact:raw}:\"MockerExecutionStarted\" AND fields.Team.${exact:raw}:${Team:lucene} AND fields.System.${exact:raw}:${System:lucene} AND fields.Environment.${exact:raw}:${Environment:lucene}",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "field": "fields.Team.${exact:raw}",
              "id": "2",
              "settings": {
                "size": "25",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            },
            {
              "type": "terms",
              "field": "fields.System.${exact:raw}",
              "id": "3",
              "settings": {
                "size": "25",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ],
          "alias": "",
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "fields.Team.keyword": "Team",
              "fields.System.keyword": "System",
              "Count": "Starts",
              "fields.Team.raw": "Team",
              "fields.System.raw": "System"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Completed HTTP requests",
      "description": "Sum of requests in reported server batches. The time filter selects by batch publication time.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "${DS_ELASTICSEARCH}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "${DS_ELASTICSEARCH}"
          },
          "query": "fields.QaasEvent.${exact:raw}:\"MockerHttpRequests\" AND fields.Team.${exact:raw}:${Team:lucene} AND fields.System.${exact:raw}:${System:lucene} AND fields.Environment.${exact:raw}:${Environment:lucene}",
          "metrics": [
            {
              "id": "1",
              "type": "sum",
              "field": "fields.Requests"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "field": "fields.QaasEvent.${exact:raw}",
              "id": "2",
              "settings": {
                "size": "1",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ],
          "alias": "",
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "none",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 8,
      "title": "HTTP handler failure rate",
      "description": "Requests whose processing or response handling failed, including errors recovered by a fallback stub. Weighted by completed requests across all reported batches.",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 12,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "${DS_ELASTICSEARCH}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "${DS_ELASTICSEARCH}"
          },
          "query": "fields.QaasEvent.${exact:raw}:\"MockerHttpRequests\" AND fields.Team.${exact:raw}:${Team:lucene} AND fields.System.${exact:raw}:${System:lucene} AND fields.Environment.${exact:raw}:${Environment:lucene}",
          "metrics": [
            {
              "id": "1",
              "type": "sum",
              "field": "fields.HandlerErrors"
            },
            {
              "id": "3",
              "type": "sum",
              "field": "fields.Requests"
            },
            {
              "id": "4",
              "type": "bucket_script",
              "pipelineVariables": [
                {
                  "name": "part",
                  "pipelineAgg": "1"
                },
                {
                  "name": "total",
                  "pipelineAgg": "3"
                }
              ],
              "settings": {
                "script": "params.part / params.total"
              }
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "field": "fields.QaasEvent.${exact:raw}",
              "id": "2",
              "settings": {
                "size": "1",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ],
          "alias": "",
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "none",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Bucket Script$/"
        }
      }
    },
    {
      "id": 9,
      "title": "HTTP 5xx response rate",
      "description": "Requests with an HTTP 5xx response status, including intentionally configured 5xx responses. Weighted by completed requests across all reported batches.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "${DS_ELASTICSEARCH}"
      },
      "targets": [
        {
