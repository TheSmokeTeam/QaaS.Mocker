              "id": "2",
              "settings": {
                "size": "1",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ],
          "alias": "",
          "timeField": "@timestamp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "colorMode": "none",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Bucket Script$/"
        }
      }
    },
    {
      "id": 10,
      "title": "Route miss rate",
      "description": "Requests successfully handled by the not-found fallback after a route or method mismatch. Weighted by completed requests across all reported batches.",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 12,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "${DS_ELASTICSEARCH}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "${DS_ELASTICSEARCH}"
          },
          "query": "fields.QaasEvent.${exact:raw}:\"MockerHttpRequests\" AND fields.Team.${exact:raw}:${Team:lucene} AND fields.System.${exact:raw}:${System:lucene} AND fields.Environment.${exact:raw}:${Environment:lucene}",
          "metrics": [
            {
              "id": "1",
              "type": "sum",
              "field": "fields.Misses"
            },
            {
              "id": "3",
              "type": "sum",
              "field": "fields.Requests"
